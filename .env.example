# erxes BalanceEd environment

# Port for the plugin GraphQL/API server (standalone demo mode)
PORT=3300

# MongoDB connection used when deployed inside erxes (mongoose models).
# Leave empty in standalone demo mode (in-memory seeded store is used).
MONGO_URL=

# --- Gemma AI (Google AI Studio) ---
# Get a key at https://aistudio.google.com/apikey
# Without a key the plugin uses its built-in deterministic analytics engine
# (same output shape, heuristic scoring + templated Mongolian summaries).
GOOGLE_AI_API_KEY=
GEMMA_MODEL=gemma-3-27b-it
